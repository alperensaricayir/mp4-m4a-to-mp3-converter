<UserControl x:Class="Mp3Converter.Views.MergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mp3Converter.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MergeViewModel}"
             d:DesignHeight="560" d:DesignWidth="880">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
        <Style x:Key="PickButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- inputs -->
            <RowDefinition Height="Auto"/> <!-- options -->
            <RowDefinition Height="Auto"/> <!-- estimate -->
            <RowDefinition Height="Auto"/> <!-- actions + progress -->
            <RowDefinition Height="*"/>    <!-- log -->
        </Grid.RowDefinitions>

        <!-- Inputs -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="#F9F9F9">
            <Grid IsEnabled="{Binding IsIdle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="Video Dosyası Seç" Command="{Binding SelectVideoCommand}" Style="{StaticResource PickButton}" Margin="0,0,8,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VideoPath}" Style="{StaticResource PathBox}" Margin="0,0,0,6"
                         ToolTip="Görüntü bu dosyadan alınır. Kendi sesi varsa kullanılmaz."/>

                <Button Grid.Row="1" Grid.Column="0" Content="Ses / Medya Dosyası Seç" Command="{Binding SelectAudioCommand}" Style="{StaticResource PickButton}" Margin="0,0,8,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AudioPath}" Style="{StaticResource PathBox}" Margin="0,0,0,6"
                         ToolTip="Ses bu dosyadan alınır. Video içeren bir dosya da olabilir; sadece ses akışı kullanılır."/>

                <Button Grid.Row="2" Grid.Column="0" Content="Çıktı Konumu Seç" Command="{Binding SelectOutputFolderCommand}" Style="{StaticResource PickButton}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OutputFolder}" Style="{StaticResource PathBox}"/>
            </Grid>
        </Border>

        <!-- Options -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,8,0,0" Background="#F9F9F9">
            <Grid IsEnabled="{Binding IsIdle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Container + quality -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Çıktı Formatı ve Kalite" FontWeight="Bold" Margin="0,0,0,5"/>
                    <RadioButton Content="MKV (kopya mümkünse encode yok)" IsChecked="{Binding IsMkv}" GroupName="MergeContainer" Margin="0,0,0,3"/>
                    <RadioButton Content="MP4 (gerekirse encode)" IsChecked="{Binding IsMp4}" GroupName="MergeContainer"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Kalite:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label" Width="230"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Ses bitrate:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox SelectedItem="{Binding AudioBitrateKbps}" Width="70"
                                  xmlns:sys="clr-namespace:System;assembly=System.Runtime">
                            <sys:Int32>128</sys:Int32>
                            <sys:Int32>160</sys:Int32>
                            <sys:Int32>192</sys:Int32>
                            <sys:Int32>256</sys:Int32>
                        </ComboBox>
                        <TextBlock Text="kbps" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Duration -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Süreler Farklıysa" FontWeight="Bold" Margin="0,0,0,5"/>
                    <RadioButton Content="Video bitene kadar devam et (varsayılan)" IsChecked="{Binding IsVideoLength}" GroupName="MergeDuration" Margin="0,0,0,3"/>
                    <RadioButton Content="Kısa olan bitince çıktıyı bitir" IsChecked="{Binding IsShortest}" GroupName="MergeDuration"/>
                </StackPanel>

                <!-- Sync -->
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Senkronizasyon" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ses gecikmesi / offset (ms):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding AudioOffsetMs, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="24" VerticalContentAlignment="Center"
                                 ToolTip="+3000 = ses 3 sn geç başlar, -3000 = sesin ilk 3 sn'si atılır"/>
                    </StackPanel>
                    <TextBlock Text="+ geciktirir, − baştan kırpar" FontSize="11" Foreground="Gray" Margin="0,2,0,4"/>
                    <CheckBox Content="Metadata start_time farkını da uygula" IsChecked="{Binding UseMetadataOffset}"
                              ToolTip="FFprobe ile okunan start_time farkı (ses − video) offsete eklenir."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Estimate -->
        <Border Grid.Row="2" BorderBrush="#A5D6A7" BorderThickness="1" Padding="10" Margin="0,8,0,0" Background="#E8F5E9">
            <StackPanel>
                <TextBlock Text="{Binding EstimateText}" FontSize="16" FontWeight="Bold" Foreground="#1B5E20"/>
                <TextBlock Text="{Binding EstimateDetailText}" Foreground="#2E7D32" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding EstimateWarning}" Foreground="#C62828" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstimateWarning}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Actions + progress -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Detaylar / Log" Command="{Binding ToggleLogCommand}" Padding="12,8" Margin="0,0,10,0"/>
                    <Button Content="Çıktı Klasörünü Aç" Command="{Binding OpenOutputFolderCommand}" Padding="12,8" Margin="0,0,10,0"/>
                    <Button Content="İptal" Command="{Binding CancelCommand}" Padding="15,8" Margin="0,0,10,0" Background="#F44336" Foreground="White" FontWeight="Bold"/>
                    <Button Content="Birleştir" Command="{Binding MergeCommand}" Padding="20,8" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Durum:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Completed">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Error">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Cancelled">
                                        <Setter Property="Foreground" Value="#EF6C00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="22"/>
                <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Grid>

        <!-- Log -->
        <GroupBox Grid.Row="4" Header="Detaylar / Log" Margin="0,8,0,0"
                  Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                     TextChanged="LogTextBox_TextChanged"/>
        </GroupBox>
    </Grid>
</UserControl>
