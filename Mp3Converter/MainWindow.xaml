<Window x:Class="Mp3Converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mp3Converter.ViewModels"
        xmlns:core="clr-namespace:Mp3Converter.Core"
        xmlns:views="clr-namespace:Mp3Converter.Views"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Media Converter — Dönüştür / Birleştir / Küçült / Kırp" Height="720" Width="980" MinHeight="580" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Visibility="Visible">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">

        <!-- Download Overlay (covers both tabs) -->
        <Grid Background="#AAFFFFFF" Panel.ZIndex="1000" Visibility="{Binding IsDownloadingFfmpeg, Converter={StaticResource BoolToVis}}">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" CornerRadius="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel Width="300">
                    <TextBlock Text="Downloading FFmpeg..." FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="20" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:0}%}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait, this may take a while depending on your internet speed." TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" Foreground="Gray"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl>
        <TabItem Header="  Dönüştür (MP3 / MP4)  ">
        <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- List -->
            <RowDefinition Height="Auto"/> <!-- Settings -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
            <RowDefinition Height="100"/>  <!-- Log -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Add Files" Command="{Binding AddFilesCommand}" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Add Folder" Command="{Binding AddFolderCommand}" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Clear Completed" Command="{Binding ClearCompletedCommand}" Padding="10,5" Margin="0,0,10,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Progress" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="15"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Input Path" Binding="{Binding InputPath}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Output Path" Binding="{Binding OutputPath}" Width="*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Action" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Settings & Output -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,10" Padding="10" Background="#F9F9F9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Output Format + Quality -->
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Output Format" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="MP3 (audio)" IsChecked="{Binding IsMp3Output}" GroupName="OutputFormat" Margin="0,0,15,0"/>
                        <RadioButton Content="MP4 (video)" IsChecked="{Binding IsMp4Output}" GroupName="OutputFormat"/>
                    </StackPanel>

                    <TextBlock Text="Quality Settings" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5" IsEnabled="{Binding IsMp3Output}">
                        <RadioButton Content="CBR (Constant)" IsChecked="{Binding QualitySettings.IsCbr}" GroupName="Mode" Margin="0,0,10,0"/>
                        <RadioButton Content="VBR (Variable)" GroupName="Mode"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Audio bitrate:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox SelectedItem="{Binding QualitySettings.Bitrate}" Width="80">
                            <sys:Int32>128</sys:Int32>
                            <sys:Int32>192</sys:Int32>
                            <sys:Int32>256</sys:Int32>
                            <sys:Int32>320</sys:Int32>
                        </ComboBox>
                        <TextBlock Text="kbps" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMp3Output}" Value="True"/>
                                            <Condition Binding="{Binding QualitySettings.IsCbr}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Quality (V0-V5):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox SelectedItem="{Binding QualitySettings.VbrQuality}" Width="60">
                            <sys:Int32>0</sys:Int32>
                            <sys:Int32>1</sys:Int32>
                            <sys:Int32>2</sys:Int32>
                            <sys:Int32>3</sys:Int32>
                            <sys:Int32>4</sys:Int32>
                            <sys:Int32>5</sys:Int32>
                        </ComboBox>
                        <TextBlock Text="(0 is best)" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Output Folder -->
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,0,0,0">
                    <TextBlock Text="Output Folder" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutputFolder}" IsReadOnly="True" VerticalContentAlignment="Center" Height="25"/>
                        <Button Grid.Column="1" Content="..." Command="{Binding SelectOutputFolderCommand}" Width="30" Margin="5,0,0,0"/>
                    </Grid>
                    <CheckBox Content="Skip existing files" IsChecked="{Binding SkipExisting}" Margin="0,5,0,0"/>
                    <Button Content="Open Output Folder" Command="{Binding OpenOutputFolderCommand}" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Content="Start Conversion" Command="{Binding StartCommand}" Padding="20,10" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"
                    IsEnabled="{Binding IsNotConverting}"/>
            <Button Content="Pause Queue" Command="{Binding PauseCommand}" Padding="15,10" Margin="0,0,10,0" IsEnabled="{Binding IsConverting}"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="15,10" Background="#F44336" Foreground="White" FontWeight="Bold" IsEnabled="{Binding IsConverting}"/>
        </StackPanel>

        <!-- Log -->
        <GroupBox Grid.Row="4" Header="Logs">
            <TextBox Text="{Binding LogText}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/>
        </GroupBox>

        </Grid>
        </TabItem>

        <TabItem Header="  Video + Ses Birleştir  ">
            <views:MergeView DataContext="{Binding Merge}" Margin="8"/>
        </TabItem>

        <TabItem Header="  Video Küçült  ">
            <views:CompressView DataContext="{Binding Compress}" Margin="8"/>
        </TabItem>

        <TabItem Header="  Video Kırp  ">
            <views:TrimView DataContext="{Binding Trim}" Margin="8"/>
        </TabItem>
        </TabControl>

    </Grid>
</Window>
